{
  "name": "phlebas",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/lib/*.test.ts services/*.test.ts services/gateway/*.test.ts services/matcher/*.test.ts services/observer/*.test.ts services/atomic-swap-observer/*.test.ts",
    "record:sepolia": "node scripts/record-sepolia-deploy.mjs",
    "test:contracts": "forge test --root contracts",
    "test:browser": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "gateway": "node --experimental-strip-types services/gateway/server.ts",
    "matcher": "node --experimental-strip-types services/matcher/server.ts",
    "observer": "node --experimental-strip-types services/observer/server.ts",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:contracts && npm run scan:secrets && npm run build",
    "check:browser": "npm run check && npm run test:browser"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
