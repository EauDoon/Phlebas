{
  "name": "phlebas",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:contracts": "forge fmt --root contracts --check",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/lib/*.test.ts\" \"services/**/*.test.ts\"",
    "test:manifests": "node scripts/validate-conditional-lock-manifest.mjs contracts/manifests/conditional-lock.not-deployed.json && node --test \"scripts/*.test.mjs\"",
    "build:contracts": "forge build src/swap/ConditionalLock.sol --root contracts --sizes",
    "test:contracts": "forge test --root contracts",
    "test:browser": "playwright test",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "matcher": "node --experimental-strip-types services/matcher/server.ts",
    "check": "npm run lint && npm run lint:contracts && npm run typecheck && npm run test && npm run test:manifests && npm run build:contracts && npm run test:contracts && npm run scan:secrets && npm run build",
    "check:browser": "npm run check && npm run test:browser"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.6.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "typescript": "^5"
  }
}
